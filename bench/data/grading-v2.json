  "items": {
    "cond-number": {
      "prompt": "In a class, 30% of students take both stats and econ, and 50% take stats. What's the probability that a stats student also takes econ?",
      "format": "number",
      "facet": "procedural",
      "difficulty": 1,
      "key": {
        "accepted": ["0.6"],
        "tolerance": { "abs": 0.005 },
        "rubric": [
          { "point": "Gets the value 0.6, i.e. divides P(both) by P(stats)" },
          { "point": "States it as a probability: 0.6 or 60%" }
        ],
        "misconceptions": [
          { "answer": "0.3", "tag": "used the joint probability" },
          { "answer": "0.15", "tag": "multiplied instead of dividing" },
          { "answer": "0.5", "tag": "used P(stats)" }
        ],
        "solution": "P(econ | stats) = P(both) / P(stats) = 0.30 / 0.50 = 0.6"
      }
    },
    "expected-number": {
      "prompt": "A game pays 10 dollars with probability 0.2 and nothing otherwise. What is the expected payout?",
      "format": "number",
      "facet": "procedural",
      "difficulty": 1,
      "key": {
        "accepted": ["2"],
        "tolerance": { "abs": 0.005 },
        "rubric": [
          { "point": "Weights each payout by its probability and adds them (10 × 0.2 + 0 × 0.8)" },
          { "point": "Gets 2 dollars" }
        ],
        "misconceptions": [
          { "answer": "5", "tag": "averaged the payouts" },
          { "answer": "10", "tag": "gave the prize, not the average" },
          { "answer": "0.2", "tag": "gave the probability" }
        ],
        "solution": "E[payout] = 10 × 0.2 + 0 × 0.8 = 2 dollars"
      }
    },
    "se-short": {
      "prompt": "If you want to cut the standard error of a sample mean in half, how should the sample size change?",
      "format": "short_text",
      "facet": "conceptual",
      "difficulty": 2,
      "key": {
        "accepted": ["Multiply the sample size by 4", "Quadruple n"],
        "rubric": [
          { "point": "Says the sample size must increase" },
          { "point": "Gives the factor 4 (quadruple the sample size)" },
          { "point": "Connects it to the standard error being proportional to 1 over the square root of n", "required": false }
        ],
        "misconceptions": [{ "answer": "double the sample size", "tag": "thinks SE is proportional to 1/n" }],
        "solution": "SE = σ/√n, so halving SE needs √n to double, which means n must be multiplied by 4."
      }
    },
    "bayes-number": {
      "prompt": "1% of people have a disease. A test catches 90% of cases and gives a false positive for 9% of healthy people. If someone tests positive, roughly what's the chance they have the disease?",
      "format": "number",
      "facet": "application",
      "difficulty": 3,
      "key": {
        "accepted": ["0.09174"],
        "tolerance": { "abs": 0.002 },
        "rubric": [
          { "point": "Uses Bayes' rule: true positives divided by all positives" },
          { "point": "Counts the false positives among the 99% who are healthy" },
          { "point": "Gets about 9%" }
        ],
        "misconceptions": [
          { "answer": "0.9", "tag": "confused P(+|D) with P(D|+)" },
          { "answer": "0.01", "tag": "ignored the test result" },
          { "answer": "0.91", "tag": "used 1 minus the false positive rate" }
        ],
        "solution": "P(D|+) = 0.01×0.9 / (0.01×0.9 + 0.99×0.09) = 0.009 / 0.0981 ≈ 0.092"
      }
    },
    "binomial-expression": {
      "prompt": "Each of n independent trials succeeds with probability p. Write an expression for the probability of at least one success.",
      "format": "expression",
      "facet": "procedural",
      "difficulty": 2,
      "key": {
        "accepted": ["1-(1-p)^n"],
        "variables": ["p", "n"],
        "rubric": [
          { "point": "Uses the complement: 1 minus the probability of no successes" },
          { "point": "Writes the probability of no successes as (1-p)^n" }
        ],
        "misconceptions": [
          { "answer": "n*p", "tag": "added the probabilities" },
          { "answer": "1-p^n", "tag": "complemented the wrong event" },
          { "answer": "p^n", "tag": "gave P(all succeed)" },
          { "answer": "(1-p)^n", "tag": "gave P(no successes), forgot 1 minus", "verdict": "partial" }
        ],
        "solution": "P(at least one) = 1 − P(none) = 1 − (1−p)^n"
      }
    },
    "independence-short": {
      "prompt": "Events A and B are independent, with P(A) = 0.5 and P(B) = 0.4. What is P(A and B), and why?",
      "format": "short_text",
      "facet": "conceptual",
      "difficulty": 1,
      "key": {
        "accepted": ["0.2, because for independent events P(A and B) = P(A)P(B)"],
        "rubric": [
          { "point": "Gives 0.2" },
          { "point": "Justifies it with independence: P(A and B) = P(A) × P(B)" }
        ],
        "misconceptions": [{ "answer": "0.9", "tag": "added the probabilities" }],
        "solution": "Independent events multiply: P(A and B) = 0.5 × 0.4 = 0.2"
      }
    },
    "sampling-choice": {
      "prompt": "Which of these is a sampling distribution?",
      "format": "choice",
      "choices": [
        "The heights of the 50 students in one sample",
        "The distribution of the sample mean over all possible samples of size 50",
        "The heights of all students at the college",
        "A histogram of one sample's residuals"
      ],
      "facet": "conceptual",
      "difficulty": 2,
      "key": {
        "accepted": ["B"],
        "rubric": [{ "point": "Chooses B, the distribution of a statistic across samples" }],
        "solution": "A sampling distribution describes how a statistic (here the sample mean) varies across all possible samples: B."
      }
    },
    "ci-short": {
      "prompt": "A 95% confidence interval for a mean is (4.1, 5.3). What does the 95% refer to?",
      "format": "short_text",
      "facet": "conceptual",
      "difficulty": 3,
      "key": {
        "accepted": ["The method: about 95% of intervals built this way, over repeated samples, capture the true mean"],
        "rubric": [
          { "point": "Says the 95% describes the procedure over repeated samples, not this one interval" },
          { "point": "Says what is captured is the true (population) mean" }
        ],
        "misconceptions": [
          { "answer": "There is a 95% probability the true mean is between 4.1 and 5.3", "tag": "probability statement about one interval" },
          { "answer": "95% of the data are between 4.1 and 5.3", "tag": "confused the interval with the data" }
        ],
        "solution": "95% is the long-run success rate of the method: in repeated sampling, about 95% of such intervals contain the population mean. This particular interval either contains it or doesn't."
      }
    },
    "raffle-short": {
      "prompt": "A raffle ticket costs $5. There's a 1 in 100 chance of winning $300. Should a risk-neutral person buy it? Explain using expected value.",
      "format": "short_text",
      "facet": "application",
      "difficulty": 2,
      "key": {
        "accepted": ["No: expected winnings are 0.01 × 300 = $3, less than the $5 cost, so the net expected value is −$2"],
        "rubric": [
          { "point": "Computes the expected winnings, 0.01 × 300 = $3 (or the net, −$2)" },
          { "point": "Compares them with the $5 cost" },
          { "point": "Concludes they shouldn't buy it" }
        ],
        "solution": "E[winnings] = 0.01 × 300 = 3 < 5, so the net expected value is −$2: a risk-neutral person doesn't buy."
      }
    },
    "variance-number": {
      "prompt": "X is 1 with probability 0.3 and 0 otherwise. What is Var(X)?",
      "format": "number",
      "facet": "procedural",
      "difficulty": 3,
      "key": {
        "accepted": ["0.21"],
        "tolerance": { "abs": 0.0005 },
        "rubric": [
          { "point": "Uses Var = p(1 − p), or E[X²] − E[X]²" },
          { "point": "Gets 0.21" }
        ],
        "misconceptions": [
          { "answer": "0.3", "tag": "gave the mean" },
          { "answer": "0.09", "tag": "squared the mean" },
          { "answer": "0.7", "tag": "gave 1 − p" }
        ],
        "solution": "Var(X) = p(1 − p) = 0.3 × 0.7 = 0.21"
      }
    }
  },
