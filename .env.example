# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude writes lessons and grades answers
ANTHROPIC_API_KEY=
# Optional: another Claude model id (default claude-sonnet-4-6)
LYCEO_MODEL=

# Whisper transcribes uploaded recordings
OPENAI_API_KEY=

# Theo's voice
ELEVENLABS_API_KEY=
# Optional: voice and model overrides (defaults: JBFqnCBsd6RMkjVDRZzb, eleven_multilingual_v2)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Cloudflare R2 caches generated audio
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=

# UploadThing receives PDFs and recordings
UPLOADTHING_TOKEN=

# Optional: secret for signing audio links (defaults to one derived from ELEVENLABS_API_KEY)
LYCEO_TTS_SECRET=
